# Скопируйте этот файл в .env и впишите ОДИН ключ. Файл .env в .gitignore и в репозиторий не попадёт.

# Бесплатно, банковская карта не нужна. Ключ: https://console.groq.com/keys
GROQ_API_KEY=

# Запасной бесплатный вариант. Ключ: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Локальная модель (например, Ollama), без ключа:
# CARDGEN_BASE_URL=http://localhost:11434/v1
# CARDGEN_MODEL=llama3.1

# Платный Anthropic (нужен pip install anthropic):
# ANTHROPIC_API_KEY=

# Необязательно: другая модель выбранного провайдера
# CARDGEN_MODEL=
